@mode(host.dual)

# Top level of grep: parse the arguments (a usage error gets GNU's Usage
# and Try lines), handle --version and --help, run the search and turn the
# outcome into grep's exit status: 0 selected, 1 none, 2 trouble.
#
# Runtime: host.dual. Compiled into the native binary build/grep by `make
# build`; `loup run source/main.loup` interprets the same code, and the unit
# tests call run() directly.

from appinfo import (APP_NAME, EXIT_OK, EXIT_TROUBLE);
from cli.args import (parse_args);
from cli.usage import (usage, version_line, USAGE_LINE, TRY_LINE);
from commands.grep import (run_grep);

# Parses argv, runs grep and returns the exit status.
pub func run(argv: list[string]): int {
    let opts = match parse_args(argv) {
        Ok(parsed) => parsed,
        Err(e) => {
            if (e.message.len() > 0) {
                printErr(APP_NAME + ": " + e.message);
            }
            if (e.usage) {
                printErr(USAGE_LINE);
                printErr(TRY_LINE);
            }
            return EXIT_TROUBLE;
        },
    };

    if (opts.version) {
        println(version_line());
        return EXIT_OK;
    }
    if (opts.help) {
        println(usage());
        return EXIT_OK;
    }

    try {
        return run_grep(opts);
    } catch (Exception as e) {
        printErr(APP_NAME + ": " + e.message);
        return EXIT_TROUBLE;
    }
}
