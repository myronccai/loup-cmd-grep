@mode(host.dual)

# Application identity for grep: name, version, summary and exit statuses.
# Keep APP_NAME and APP_VERSION in step with `name` and `version` in
# package.lppkg.
#
# Runtime: host.dual. Constants only. Compiled into build/grep by `make
# build`; `loup run source/main.loup` interprets the same code.

pub const APP_NAME: string = "grep";
pub const APP_VERSION: string = "0.1.0";
pub const APP_SUMMARY: string = "Print lines that match patterns (a Loup recreation of GNU grep).";

# Exit statuses returned by main(), as in GNU grep.
pub const EXIT_OK: int = 0;        # a line was selected
pub const EXIT_NO_MATCH: int = 1;  # no line was selected
pub const EXIT_TROUBLE: int = 2;   # usage error, bad pattern or unreadable input
