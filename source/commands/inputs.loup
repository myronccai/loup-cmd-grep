@mode(host.dual)

# Helpers for reading inputs: lines, binary detection and paths.
#
# Runtime: host.dual. Compiled into the native binary build/grep by `make
# build`; `loup run source/main.loup` interprets the same code.

pub const STDIN_LABEL: string = "(standard input)";

# The lines of `text`. A final newline ends the last line rather than
# starting an empty one; a last line without a newline still counts.
pub func split_lines(text: string): list[string] {
    if (text.len() == 0) {
        return [];
    }
    var lines = text.split("\n");
    if (lines.len() > 0 and lines[lines.len() - 1].len() == 0) {
        lines.pop();
    }
    return lines;
}

# Whether `data` is binary for grep: it holds a NUL byte or is not valid
# UTF-8 (GNU grep's rule in a UTF-8 locale).
pub func is_binary(data: bytes): bool {
    let n = data.len();
    var i = 0;
    while (i < n) {
        let b = data[i];
        if (b == 0) {
            return true;
        }
        if (b < 0x80) {
            i += 1;
            continue;
        }
        var need = 0;
        var min2 = 0x80;
        var max2 = 0xBF;
        if (b >= 0xC2 and b <= 0xDF) {
            need = 1;
        } else if (b >= 0xE0 and b <= 0xEF) {
            need = 2;
            if (b == 0xE0) {
                min2 = 0xA0;
            } else if (b == 0xED) {
                max2 = 0x9F;
            }
        } else if (b >= 0xF0 and b <= 0xF4) {
            need = 3;
            if (b == 0xF0) {
                min2 = 0x90;
            } else if (b == 0xF4) {
                max2 = 0x8F;
            }
        } else {
            return true;
        }
        if (i + need >= n) {
            return true;
        }
        let second = data[i + 1];
        if (second < min2 or second > max2) {
            return true;
        }
        var k = 2;
        while (k <= need) {
            let cont = data[i + k];
            if (cont < 0x80 or cont > 0xBF) {
                return true;
            }
            k += 1;
        }
        i += need + 1;
    }
    return false;
}

# The path of `rel` (a path from io.fs.walk) under directory `dir`.
pub func child_path(dir: string, rel: string): string {
    if (dir.endsWith("/")) {
        return dir + rel;
    }
    return dir + "/" + rel;
}
