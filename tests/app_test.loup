@mode(host.dual)

# Exit statuses of the whole command line. These tests print the program's
# normal output and messages.

from debug.assert import (expectEq);
from appinfo import (EXIT_OK, EXIT_NO_MATCH, EXIT_TROUBLE);
from cli.app import (run);

func test_version_and_help_succeed(): void {
    expectEq(run(["--version"]), EXIT_OK, "--version");
    expectEq(run(["--help"]), EXIT_OK, "--help");
}

func test_match_and_no_match(): void {
    expectEq(run(["-q", "fox", "tests/fixtures/poem.txt"]), EXIT_OK, "match");
    expectEq(run(["-q", "zebra", "tests/fixtures/poem.txt"]), EXIT_NO_MATCH, "no match");
}

func test_errors_give_status_2(): void {
    let none: list[string] = [];
    expectEq(run(none), EXIT_TROUBLE, "no pattern");
    expectEq(run(["-k", "x"]), EXIT_TROUBLE, "bad option");
    expectEq(run(["a\\(", "tests/fixtures/poem.txt"]), EXIT_TROUBLE, "bad pattern");
    expectEq(run(["-s", "x", "tests/no-such-file"]), EXIT_TROUBLE, "missing file");
}
