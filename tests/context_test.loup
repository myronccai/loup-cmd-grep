@mode(host.dual)

# Unit tests for the -B ring buffer (commands.context): it keeps the newest
# lines, clears, and holds nothing at capacity 0.
#
# Runtime: host.dual, run by the test runner: `make test` interprets this
# file with Stage0 (`loup-bootstrap test`, source/ on LOUPPATH), one test
# per `func test_*()`. It is not part of the binary.

from debug.assert import (expectEq);
from commands.context import (ContextRing);

func test_keeps_the_newest_lines(): void {
    let r = ContextRing(2);
    safe {
        r.push(0, "a");
        r.push(1, "b");
        r.push(2, "c");
    }
    expectEq(r.size, 2, "capacity");
    expectEq(r.number_at(0), 1, "oldest kept");
    expectEq(r.text_at(0), "b", "oldest text");
    expectEq(r.text_at(1), "c", "newest text");
}

func test_clear(): void {
    let r = ContextRing(3);
    safe {
        r.push(4, "x");
        r.clear();
        r.push(5, "y");
    }
    expectEq(r.size, 1, "one after clear");
    expectEq(r.number_at(0), 5, "new entry");
}

func test_zero_capacity_holds_nothing(): void {
    let r = ContextRing(0);
    safe {
        r.push(0, "a");
    }
    expectEq(r.size, 0, "empty");
}
